alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL Port Scan - Multiple Ports from Single Source"; flow:to_server; flags:S,12; threshold:type threshold, track by_src, count 200, seconds 60; classtype:attempted-recon; sid:1000001; rev:2;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL Slow Port Scan - Many Refused Connections to Single Source"; flow:to_client; flags:RA,12; threshold:type both, track by_dst, count 50, seconds 300; classtype:attempted-recon; sid:1000006; rev:1;)
