alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL Gobuster Directory Scan Detected"; flow:to_server; http.user_agent; content:"gobuster"; nocase; classtype:web-application-attack; sid:1000002; rev:2;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL HTTP 404 Burst - Directory Enumeration (UA-agnostic)"; flow:to_client,established; http.stat_code; content:"404"; threshold:type both, track by_dst, count 50, seconds 60; classtype:web-application-attack; sid:1000005; rev:1;)
